# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional overrides
DOCX_AGENT_PROVIDER=google_genai
# Empty selects the first GEMINI_MODELS entry (or Claude for the anthropic provider).
DOCX_AGENT_MODEL=
DOCX_AGENT_EFFORT=medium
DOCX_AGENT_MAX_RETRIES=2
DOCX_AGENT_MAX_TURNS=30

GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
